<?xml version="1.0" encoding="utf-8"?>
<!-- Same rules as backup_rules.xml for API 31+: library and settings only; no datasets, no cache, no secrets (files/secrets/). The -wal / -shm files go with the database (write-ahead log). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="trackstuff.db"/>
        <include domain="database" path="trackstuff.db-wal"/>
        <include domain="database" path="trackstuff.db-shm"/>
        <include domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="trackstuff.db"/>
        <include domain="database" path="trackstuff.db-wal"/>
        <include domain="database" path="trackstuff.db-shm"/>
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
