<?xml version="1.0" encoding="utf-8"?>
<!-- Same rules as backup_rules.xml for API 31+: library and settings only, no datasets, no cache. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="trackstuff.db"/>
        <include domain="file" path="datastore/"/>
        <exclude domain="database" path="imdb.db"/>
        <exclude domain="database" path="omdb_org.db"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="trackstuff.db"/>
        <include domain="file" path="datastore/"/>
        <exclude domain="database" path="imdb.db"/>
        <exclude domain="database" path="omdb_org.db"/>
    </device-transfer>
</data-extraction-rules>
