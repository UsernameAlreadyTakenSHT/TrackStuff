<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: a film frame with a check mark ("tracked"). Drawn inside the 66 dp safe zone of the
    108 dp adaptive canvas. The same drawable serves as the monochrome (themed) icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Film frame: outer rounded rectangle minus the inner window (even-odd). -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M30,30 h48 a6,6 0 0 1 6,6 v36 a6,6 0 0 1 -6,6 h-48 a6,6 0 0 1 -6,-6 v-36 a6,6 0 0 1 6,-6 z
                          M40,38 h28 v32 h-28 z" />
    <!-- Sprocket holes cut into the two side bands. -->
    <path
        android:fillColor="#4A5A8C"
        android:pathData="M31,40 h4 v5 h-4 z M31,49 h4 v5 h-4 z M31,58 h4 v5 h-4 z M31,67 h4 v5 h-4 z
                          M73,40 h4 v5 h-4 z M73,49 h4 v5 h-4 z M73,58 h4 v5 h-4 z M73,67 h4 v5 h-4 z" />
    <!-- Check mark in the window. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M45,54 l6,6 l12,-13" />
</vector>
